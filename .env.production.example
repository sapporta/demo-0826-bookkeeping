NODE_ENV=production
SAPPORTA_API_PORT=3000

BETTER_AUTH_SECRET=
SAPPORTA_PUBLIC_APP_URL=https://app.example.com

SAPPORTA_FRONTEND_ORIGINS=
SAPPORTA_HEALTH_POLICY=authenticated
SAPPORTA_OPENAPI_POLICY=authenticated

SAPPORTA_MAIL_TRANSPORT=smtp
SAPPORTA_MAIL_FROM="Sapporta <no-reply@app.example.com>"

SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Only a public demo sets this. It signs the whole API in as the named account:
# every request without a credential is served as it, and the sign-in pages
# become unreachable. Leave it unset in any deployment holding real data.
# SAPPORTA_DEMO_USER_EMAIL=test@example.com

# Only a public demo sets this. It publishes `POST /api/demo-reset`, which puts
# every table back to the snapshot named here and brings its dates up to today.
# The Dockerfile builds that snapshot into the image at the path below, which
# is outside the data volume on purpose: a snapshot kept on the volume outlives
# the image whose schema it matched. On a demo the route needs no credential,
# because SAPPORTA_DEMO_USER_EMAIL above already serves every uncredentialed
# request as the demo account.
# SAPPORTA_DEMO_SNAPSHOT=/app/demo-snapshot.db
