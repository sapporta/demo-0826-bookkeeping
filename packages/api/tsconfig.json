{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "app",
    "authz",
    "modules",
    "project-auth",
    "schema"
  ],
  "exclude": [
    "dist",
    "**/*.test.ts"
  ]
}
